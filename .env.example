# Copy to .env and fill your own values. NEVER commit .env.
LOGGAMERA_EMAIL="your_email@example.com"
LOGGAMERA_PASSWORD="replace-with-your-password"
LOGGAMERA_DEVICE_ID="YOUR_DEVICE_ID"
TZ="Europe/Riga"
# 24h local time = room temperature in Celsius, 10–30
COMFORTZONE_SCHEDULE="02:00=24,06:00=19,12:00=24,16:00=19"
